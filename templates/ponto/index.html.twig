{% extends 'base.html.twig' %}

{% block title %}Ponto eletrônico{% endblock %}

{% block body %}
    <style>

        table {
            border-collapse: collapse;
            margin: 20px auto;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

        /* Even row styling */
        tr:nth-child(even) {
            background-color: #f2f2f2;
        }

        /* Odd row styling */
        tr:nth-child(odd) {
            background-color: #fff;
        }
        .notification {
            text-align: center;
            background-color: #4CAF50;
            color: #fff;
            padding: 15px;
            margin-bottom: 1rem;
            border-radius: 5px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            z-index: 1;
        }
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin: 50px;
        }
        #timeDisplay {
            font-size: 24px;
            margin-bottom: 20px;
        }
        #registerButton {
            padding: 10px 20px;
            font-size: 16px;
            cursor: pointer;
        }
        dl {
            margin-bottom: 20px;
        }

        dt, dd {
            display: inline-block;
            margin: 0;
        }

        dt {
            font-weight: bold;
        }

        /* Optional: Add some spacing between dt and dd */
        dt + dd {
            margin-left: 10px;
        }
    </style>
    <h1>Ponto eletrônico</h1>
    {# read and display all flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ label }} notification" id="notification">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
    <div id="timeDisplay"><span id="currentDateTime"></span></div>
    <div id="timeDisplay">Tempo total (até {{ agora.format('H:i') }}): {{ tempoTotalDia|minutos }}</span></div>
    <div id="timeDisplay" style="font-weight: bolder"><span id="tempoSaida"></span></div>
    <form method="POST">
        <button id="registerButton" type="submit">Registrar Entrada</button>
    </form>
    <br />
    <div>Horários registrados hoje:</div>
    <dl>
        {% for registro in registros %}
            <dt>{{ cycle(['Entrada', 'Saída'], loop.index0) }}:</dt>
            <dd>{{ registro.dataRegistro.format('H:i') }}</dd>
        {% endfor %}
    </dl>
    <script>
        function updateCurrentDateTime() {
            var currentDateTimeElement = document.getElementById("currentDateTime");
            var currentDateTime = new Date();

            var day = currentDateTime.getDate();
            var month = currentDateTime.getMonth() + 1; // Months are zero-based
            var year = currentDateTime.getFullYear();

            var hours = currentDateTime.getHours();
            var minutes = currentDateTime.getMinutes();

            var formattedDate = (day < 10 ? "0" : "") + day + "/" + (month < 10 ? "0" : "") + month + "/" + year;
            var formattedTime = hours + ":" + (minutes < 10 ? "0" : "") + minutes;

            currentDateTimeElement.innerHTML = formattedDate + " " + formattedTime;

            const elements = document.getElementsByClassName('hoje');
            const timestamps = Array.from(elements).map(elemento => {
                // Acessa o atributo data-seconds e converte para Inteiro
                return parseInt(elemento.dataset.seconds, 10);
            });
            const resultado = calcularHorarioSaida(timestamps)
            if (resultado == null){
                const tempoSaida = document.getElementById("tempoSaida");
                tempoSaida.innerHTML = "";
            }
            const dataSaida = new Date(resultado * 1000);
            const tempoSaida = document.getElementById("tempoSaida");
            tempoSaida.innerHTML = dataSaida.toLocaleTimeString('pt-BR');
        }
        function sumirNotificacao(){
            document.getElementById('notification').style.display="none";
        }

        function calcularHorarioSaida(timestamps) {
            // 1. Garante que os timestamps estão em ordem cronológica
            // (Passo opcional se sua fonte de dados já garante a ordem)
            const sortedTimes = [...timestamps].sort((a, b) => a - b);

            // 2. Verifica se o ponto está fechado (número par de elementos)
            if (sortedTimes.length % 2 === 0) {
                return null; // O funcionário não está trabalhando no momento
            }

            // Definição de 8 horas em segundos
            const jornadaSegundos = 8 * 60 * 60; // 28800 segundos

            let segundosTrabalhados = 0;

            // 3. Itera sobre os pares FECHADOS (entrada e saída anteriores)
            // O loop vai até o penúltimo elemento
            for (let i = 0; i < sortedTimes.length - 1; i += 2) {
                const entrada = sortedTimes[i];
                const saida = sortedTimes[i + 1];
                segundosTrabalhados += (saida - entrada);
            }

            // 4. Calcula quanto falta para completar 8 horas
            const segundosRestantes = jornadaSegundos - segundosTrabalhados;

            // 5. Pega o último registro (a entrada atual em aberto)
            const ultimaEntrada = sortedTimes[sortedTimes.length - 1];

            // 6. O horário de saída é a última entrada + o que falta
            return ultimaEntrada + segundosRestantes;
        }

        // Update time initially and set interval to update every second
        updateCurrentDateTime();
        setInterval(updateCurrentDateTime, 1000);
        setInterval(sumirNotificacao, 5000);
    </script>
    <table>
        <tbody>
        {% set sum = 0 %}
        {% set lastDay = dias|length %}
        {% for indice, dia in dias%}
            <tr>
                <td>
                    <div>{{ dia.data|date("d/m/Y") }}</div>
                    <div>({{ dia.data|date("l")| trans({}, 'messages', 'pt_BR') }})</div>
                </td>
                {% for registro in dia.valores %}
                    {% if indice == lastDay-1 %}
                    <td class="hoje" >
                        {{ registro.dataRegistro.format('H:i') }}
                    </td>
                    {% else %}
                        <td class="hoje" data-seconds="{{ registro.dataRegistro.format('U') }}">
                            {{ registro.dataRegistro.format('H:i') }}
                        </td>
                    {% endif %}
                {% endfor %}


                {% if dia.valores|  length %2 == 0 %}
                    <td>Total do dia:</td>
                    <td>{{ dia.total|minutos }} ({{ (dia.total-(8*60))|minutos }})</td>
                    {% set sum = sum + dia.total - (8*60) %}
                    <td>Total acumulado:</td>
                    <td>{{ sum|minutos }}</td>
                {% endif %}

            </tr>
        {%endfor %}

        </tbody>

    </table>
    <div><h3>Tempo total acumulado:{{ tempoTotal|minutos }}</h3></div>
{% endblock %}
